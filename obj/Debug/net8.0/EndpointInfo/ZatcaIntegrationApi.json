{
  "openapi": "3.0.1",
  "info": {
    "title": "ZatcaIntegrationApi",
    "version": "1.0"
  },
  "paths": {
    "/api/zatca/generate-csr": {
      "post": {
        "tags": [
          "Zatca"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CsrRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CsrRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CsrRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/zatca/validate-invoice": {
      "post": {
        "tags": [
          "Zatca"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceValidationRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceValidationRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceValidationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/zatca/process-invoice": {
      "post": {
        "tags": [
          "Zatca"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceProcessingRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceProcessingRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceProcessingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CsrRequest": {
        "type": "object",
        "properties": {
          "commonName": {
            "type": "string",
            "nullable": true
          },
          "serialNumber": {
            "type": "string",
            "nullable": true
          },
          "organizationIdentifier": {
            "type": "string",
            "nullable": true
          },
          "organizationUnitName": {
            "type": "string",
            "nullable": true
          },
          "organizationName": {
            "type": "string",
            "nullable": true
          },
          "countryName": {
            "type": "string",
            "nullable": true
          },
          "invoiceType": {
            "type": "string",
            "nullable": true
          },
          "locationAddress": {
            "type": "string",
            "nullable": true
          },
          "industryBusinessCategory": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "InvoiceProcessingRequest": {
        "type": "object",
        "properties": {
          "xml": {
            "type": "string",
            "nullable": true
          },
          "privateKey": {
            "type": "string",
            "nullable": true
          },
          "certificate": {
            "type": "string",
            "nullable": true
          },
          "pih": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "InvoiceValidationRequest": {
        "type": "object",
        "properties": {
          "xml": {
            "type": "string",
            "nullable": true
          },
          "certificate": {
            "type": "string",
            "nullable": true
          },
          "pih": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
